<Page x:Class="GameTimeTracker.Views.TabArchive"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="TabArchive" Foreground="#e0e0e0">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Архив игр" FontSize="20" FontWeight="Bold" Foreground="#00d4ff" Margin="0,0,0,15"/>

        <!-- Archived Games List -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="ArchiveList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="#1a1a2e" BorderBrush="#2a2a4e" BorderThickness="1" 
                                CornerRadius="8" Margin="0,0,0,10" Padding="15" Opacity="0.7">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding DisplayName}" FontSize="16" FontWeight="SemiBold" Foreground="#e0e0e0"/>
                                    <TextBlock Text="{Binding ExeName}" FontSize="12" Foreground="#888888" Margin="0,5,0,0"/>
                                    <TextBlock Text="Архивировано: {Binding ArchivedAtFormated}" FontSize="12" Foreground="#888888" Margin="0,2,0,0"/>
                                </StackPanel>
                                
                                <Button Grid.Column="1" Content="Восстановить" Width="100" Padding="5,8" 
                                        Background="#2a2a4e" Foreground="#00d4ff" BorderThickness="1" BorderBrush="#00d4ff"
                                        Cursor="Hand" VerticalAlignment="Center"
                                        CommandParameter="{Binding Id}" Click="BtnUnarchive_Click"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</Page>