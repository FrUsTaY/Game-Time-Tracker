<Page x:Class="GameTimeTracker.Views.TabStats"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
      Title="TabStats" Foreground="#e0e0e0">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Summary Cards -->
        <UniformGrid Grid.Row="0" Columns="3" Margin="0,0,0,15">
            <Border Background="#1a1a2e" BorderBrush="#2a2a4e" BorderThickness="1" CornerRadius="8" Margin="5" Padding="15">
                <StackPanel>
                    <TextBlock Text="Всего времени" Foreground="#888888" FontSize="12" TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="TxtTotalTime" Text="0 ч 0 м" FontSize="20" FontWeight="Bold" Foreground="#00d4ff" Margin="0,5,0,0"/>
                </StackPanel>
            </Border>
            <Border Background="#1a1a2e" BorderBrush="#2a2a4e" BorderThickness="1" CornerRadius="8" Margin="5" Padding="15">
                <StackPanel>
                    <TextBlock Text="Игр запущено" Foreground="#888888" FontSize="12" TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="TxtTotalGames" Text="0" FontSize="20" FontWeight="Bold" Foreground="#7b2fff" Margin="0,5,0,0"/>
                </StackPanel>
            </Border>
            <Border Background="#1a1a2e" BorderBrush="#2a2a4e" BorderThickness="1" CornerRadius="8" Margin="5" Padding="15">
                <StackPanel>
                    <TextBlock Text="Самая долгая сессия" Foreground="#888888" FontSize="12" TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="TxtLongestSession" Text="—" FontSize="16" FontWeight="Bold" Foreground="#e0e0e0" Margin="0,5,0,0" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </Border>
        </UniformGrid>

        <TextBlock Grid.Row="1" Text="Активность за последние 7 дней" FontSize="16" FontWeight="SemiBold" Margin="5,0,0,10" Foreground="#00d4ff"/>

        <!-- Chart -->
        <Border Grid.Row="2" Background="#1a1a2e" BorderBrush="#2a2a4e" BorderThickness="1" CornerRadius="8" Margin="5" Padding="10">
            <!-- XAML mapping for LiveCharts2 -->
            <lvc:CartesianChart x:Name="ActivityChart" />
        </Border>
    </Grid>
</Page>