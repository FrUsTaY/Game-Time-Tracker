<Window x:Class="GameTimeTracker.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Настройки GameTimeTracker" Height="500" Width="600"
        Background="#0d0d0d" Foreground="#e0e0e0"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- Autostart -->
                <TextBlock Text="Автозапуск" FontSize="18" FontWeight="Bold" Foreground="#00d4ff" Margin="0,0,0,10"/>
                <CheckBox x:Name="ChkAutostart" Content="Запускать вместе с Windows" Foreground="#e0e0e0" Margin="0,0,0,5"/>
                <CheckBox x:Name="ChkMinimizeToTray" Content="Запускать свернутым в трей" Foreground="#e0e0e0" Margin="0,0,0,20"/>

                <!-- Tracking -->
                <TextBlock Text="Трекинг" FontSize="18" FontWeight="Bold" Foreground="#00d4ff" Margin="0,0,0,10"/>
                <CheckBox x:Name="ChkTrackOnlyActive" Content="Считать время только при активном окне игры" Foreground="#e0e0e0" Margin="0,0,0,5"/>
                
                <StackPanel Orientation="Horizontal" Margin="0,5,0,5">
                    <CheckBox x:Name="ChkPauseIdle" Content="Не учитывать время при бездействии (AFK)" VerticalAlignment="Center" Foreground="#e0e0e0"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="20,0,0,20">
                    <TextBlock Text="Порог бездействия (минут):" VerticalAlignment="Center" Foreground="#888" Margin="0,0,10,0"/>
                    <TextBox x:Name="TxtIdleMinutes" Width="50" Background="#1a1a2e" Foreground="#e0e0e0" BorderBrush="#2a2a4e"/>
                </StackPanel>

                <!-- Notifications -->
                <TextBlock Text="Уведомления" FontSize="18" FontWeight="Bold" Foreground="#00d4ff" Margin="0,0,0,10"/>
                <CheckBox x:Name="ChkNotifyNewGame" Content="Показывать уведомление при новой игре" Foreground="#e0e0e0" Margin="0,0,0,5"/>
                <CheckBox x:Name="ChkNotifyLongSession" Content="Напоминать о долгой сессии" Foreground="#e0e0e0" Margin="0,0,0,5"/>
                <StackPanel Orientation="Horizontal" Margin="20,0,0,20">
                    <TextBlock Text="Через (минут):" VerticalAlignment="Center" Foreground="#888" Margin="0,0,10,0"/>
                    <TextBox x:Name="TxtLongSessionMinutes" Width="50" Background="#1a1a2e" Foreground="#e0e0e0" BorderBrush="#2a2a4e"/>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>

        <!-- Buttons -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button Content="Отмена" Width="100" Padding="5,8" Margin="0,0,10,0" Background="#1a1a2e" Foreground="#e0e0e0" BorderThickness="0" Click="BtnCancel_Click"/>
            <Button Content="Сохранить" Width="100" Padding="5,8" Background="#7b2fff" Foreground="White" BorderThickness="0" Click="BtnSave_Click"/>
        </StackPanel>
    </Grid>
</Window>