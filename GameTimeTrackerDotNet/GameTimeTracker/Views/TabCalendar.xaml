<Page x:Class="GameTimeTracker.Views.TabCalendar"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="TabCalendar" Foreground="#e0e0e0">
    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Calendar -->
        <Border Grid.Column="0" Background="#1a1a2e" BorderBrush="#2a2a4e" BorderThickness="1" CornerRadius="8" Padding="10" VerticalAlignment="Top">
            <Calendar x:Name="ActivityCalendar" 
                      Background="Transparent" Foreground="Black" 
                      SelectedDatesChanged="ActivityCalendar_SelectedDatesChanged" />
        </Border>

        <!-- Day Breakdown -->
        <Border Grid.Column="1" Background="#1a1a2e" BorderBrush="#2a2a4e" BorderThickness="1" CornerRadius="8" Margin="15,0,0,0" Padding="15">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock x:Name="TxtSelectedDate" Text="Выберите дату" FontSize="18" FontWeight="Bold" Foreground="#00d4ff" Margin="0,0,0,15"/>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="DayBreakdownList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding GameName}" Foreground="#e0e0e0" FontSize="14" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Grid.Column="1" Text="{Binding DurationFormated}" Foreground="#7b2fff" FontSize="14" FontWeight="Bold"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
                
                <TextBlock x:Name="TxtNoActivity" Text="В этот день не было активности." 
                           Foreground="#888888" HorizontalAlignment="Center" VerticalAlignment="Center" Grid.Row="1" Visibility="Collapsed"/>
            </Grid>
        </Border>
    </Grid>
</Page>